#!/usr/bin/env bash
# Runs `docker compose` from the official docker:cli image (bundles the compose plugin), so the host needs
# only the Docker engine (decision D3). The project is mounted at the same absolute path so relative paths
# in docker-compose.yml resolve identically. Usage: infra/compose up -d --build | infra/compose logs -f app
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TTY=(); [ -t 0 ] && [ -t 1 ] && TTY=(-it)
if command -v docker-compose >/dev/null 2>&1; then exec docker-compose -f "$ROOT/infra/docker-compose.yml" "$@"; fi
if docker compose version >/dev/null 2>&1; then exec docker compose -f "$ROOT/infra/docker-compose.yml" "$@"; fi
exec docker run --rm "${TTY[@]}" \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v "$ROOT":"$ROOT" -w "$ROOT/infra" \
  docker:28-cli docker compose -f "$ROOT/infra/docker-compose.yml" --project-name cep "$@"

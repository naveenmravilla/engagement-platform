# Copy to infra/.env (gitignored) and replace every value. Generate secrets with: openssl rand -base64 48
CEP_DB_PASSWORD=change-me
CEP_REDIS_PASSWORD=change-me
CEP_JWT_SECRET=change-me-to-at-least-32-random-bytes
CEP_BOOTSTRAP_TENANT=default
CEP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CEP_BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars
# Host port for the API (container listens on 8080)
CEP_HTTP_PORT=8080
